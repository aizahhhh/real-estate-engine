          "jsCode": "// ---- CONFIGURE YOUR SOURCING FILTERS HERE ----\nconst TARGET_STATES = [];   // e.g. ['TX','FL'] — empty means allow all\nconst TARGET_CITIES = [];   // e.g. [\"Austin\"] — empty means allow all\nconst MIN_PRICE = 0;        // minimum purchase price\nconst MAX_PRICE = 750000;   // maximum purchase price\nconst MIN_SCORE = 40;       // drop leads scoring below this\n// -----------------------------------------------\n\nconst num = (v) => {\n  if (v === null || v === undefined) return 0;\n  const n = parseFloat(String(v).replace(/[^0-9.\\-]/g, ''));\n  return isNaN(n) ? 0 : n;\n};\n\nconst DISTRESS = ['distress','foreclos','short sale','as-is','as is','fixer','rehab','tlc','motivated','estate','probate','vacant','handyman'];\n\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const price = num(r.price);\n  const arv = num(r.arv);\n  const state = String(r.state || '').trim().toUpperCase();\n  const city = String(r.city || '').trim().toLowerCase();\n\n  // Geographic filter\n  if (TARGET_STATES.length && !TARGET_STATES.map(s => s.toUpperCase()).includes(state)) continue;\n  if (TARGET_CITIES.length && !TARGET_CITIES.map(c => c.toLowerCase()).includes(city)) continue;\n  // Price filter\n  if (price < MIN_PRICE || (MAX_PRICE > 0 && price > MAX_PRICE)) continue;\n\n  // ---- Scoring matrix ----\n  let score = 0;\n  const reasons = [];\n  // Discount / equity spread (up to 60 pts)\n  if (arv > 0 && price > 0) {\n    const discount = (arv - price) / arv; // fraction below ARV\n    const discPts = Math.max(0, Math.min(60, Math.round(discount * 150)));\n    score += discPts;\n    if (discPts > 0) reasons.push('equity spread ' + Math.round(discount * 100) + '%');\n  }\n  // Distress signals in status text (up to 30 pts)\n  const statusText = String(r.status || '').toLowerCase();\n  const hits = DISTRESS.filter(k => statusText.includes(k));\n  if (hits.length) {\n    score += Math.min(30, hits.length * 15);\n    reasons.push('distress signal: ' + hits.join(', '));\n  }\n  // Size bonus (up to 10 pts)\n  const sqft = num(r.sqft);\n  if (sqft >= 1200) { score += 10; }\n  else if (sqft >= 800) { score += 5; }\n\n  score = Math.max(0, Math.min(100, score));\n  const grade = score >= 75 ? 'A' : score >= 60 ? 'B' : score >= 40 ? 'C' : 'D';\n  const est_profit = arv > 0 && price > 0 ? Math.round((arv - price) * 0.7) : 0;\n\n  if (score < MIN_SCORE) continue;\n\n  out.push({ json: Object.assign({}, r, {\n    price_num: price,\n    arv_num: arv,\n    profit_score: score,\n    grade,\n    est_profit,\n    score_reasons: reasons.join('; ') || 'baseline',\n  }) });\n}\nreturn out;"
        },
