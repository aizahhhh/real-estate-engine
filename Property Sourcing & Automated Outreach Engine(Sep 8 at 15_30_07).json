    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional real estate investor writing a short, warm, personalized cold outreach email to a property owner.\nWrite ONLY the email body (no subject line, no placeholders like [Name], no markdown).\nReference the specific property and be respectful and non-pushy. 90-130 words. End with a soft call to action to discuss a potential cash offer.\n\nOwner name: {{ $json.owner_name }}\nProperty address: {{ $(\"Filter & Score Listings\").item.json.address }}, {{ $(\"Filter & Score Listings\").item.json.city }}, {{ $(\"Filter & Score Listings\").item.json.state }}\nProperty status/notes: {{ $(\"Filter & Score Listings\").item.json.status }}\nBeds/Baths: {{ $(\"Filter & Score Listings\").item.json.beds }}/{{ $(\"Filter & Score Listings\").item.json.baths }}\nInvestor grade: {{ $(\"Filter & Score Listings\").item.json.grade }}",
        "batching": {}
      },
