          "jsCode": "const src = $('Filter & Score Listings').item.json;\nconst enr = $('Skip-Trace / Enrich Owner').item.json || {};\n// Basic LLM Chain outputs the generated text under $json.text\nconst emailBody = ($json.text || '').trim();\n\nreturn {\n  json: {\n    address: src.address,\n    city: src.city || '',\n    state: src.state || '',\n    zip: src.zip || '',\n    price: src.price_num,\n    arv: src.arv_num,\n    profit_score: src.profit_score,\n    grade: src.grade,\n    est_profit: src.est_profit,\n    score_reasons: src.score_reasons,\n    owner_name: enr.owner_name || '',\n    owner_phone: enr.owner_phone || '',\n    owner_email: enr.owner_email || '',\n    mailing_address: enr.mailing_address || '',\n    email_subject: \"Quick question about \" + src.address + (src.city ? \" in \" + src.city : \"\"),\n    email_body: emailBody,\n    sourced_at: new Date().toISOString(),\n    outreach_status: (enr.owner_email ? 'email_sent' : 'needs_review'),\n  }\n};"
